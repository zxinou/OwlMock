# API Keys
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Public accounts
# New visitors can register. Set false after creating accounts to close signups.
OWLMOCK_ALLOW_REGISTRATION=true
# Optional upgrade bridge for old single-owner data. Configure both values to
# create a user with id=default on startup.
OWLMOCK_BOOTSTRAP_EMAIL=
OWLMOCK_ADMIN_PASSWORD=
# Required on a public deployment. Generate with: openssl rand -hex 32
OWLMOCK_SESSION_SECRET=
OWLMOCK_SESSION_DAYS=7
OWLMOCK_COOKIE_SECURE=true
OWLMOCK_AUTH_RATE_LIMIT=8
OWLMOCK_AUTH_RATE_WINDOW_SECONDS=300

# GitHub analysis acceleration
# Optional: avoids low unauthenticated GitHub API limits.
GITHUB_TOKEN=
# Optional: local proxy such as Clash Verge. The screenshot port is 9895.
# GITHUB_HTTP_PROXY=http://127.0.0.1:9895
# GITHUB_HTTPS_PROXY=http://127.0.0.1:9895
# Optional: GitHub mirror/proxy bases. Separate multiple values with commas.
# Common services usually accept: https://mirror.example/https://github.com/owner/repo.git
# GITHUB_PROXY_BASE_URLS=
# GITHUB_PREFER_MIRROR=false
# Download order: clone_first (default) or archive_first.
# GITHUB_FETCH_STRATEGY=clone_first
# Fresh metadata avoids a network check for this many seconds.
# GITHUB_CACHE_TTL_SECONDS=300

# Optional per-scenario routing overrides. YAML values are used when unset.
# The CAPYMOCK_ prefix is kept for backward compatibility with existing configs.
# CAPYMOCK_RESUME_ANALYZER_MODEL=qwen3.5-omni-plus
# CAPYMOCK_RESUME_ANALYZER_FALLBACK_PROVIDER=zhipu
# CAPYMOCK_RESUME_ANALYZER_FALLBACK_MODEL=glm-4.6v-flash
# CAPYMOCK_REPO_ANALYZER_MODEL=qwen3.5-omni-plus-2026-03-15

# Tracer (noop | langfuse)
TRACER=noop
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_HOST=  # optional legacy alias for LANGFUSE_BASE_URL

# Storage
OWLMOCK_DATA_DIR=
SQLITE_PATH=storage/db/app.db
JSONL_ROOT=storage/sessions

# Voice / Realtime
VOICE_DEFAULT_SESSION_MINUTES=15
VOICE_INACTIVITY_TIMEOUT_SECONDS=300

# Resume
RESUME_ROOT=storage/resumes
JD_UPLOAD_ROOT=../analysis_cache/jd_uploads
